{
  "name": "focus-flight",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=focus-flight-backend",
    "dev:frontend": "npm run dev --workspace=focus-flight-frontend",
    "build": "npm run build --workspace=focus-flight-backend && npm run build --workspace=focus-flight-frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
